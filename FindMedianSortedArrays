class Solution:
    def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
        combined = nums1 + nums2
        combined.sort()
        nm = len(combined)
        
        if nm % 2 == 0:
            mid = nm // 2
            total = (combined[mid] + combined[mid - 1]) / 2
        else:
            mid = nm // 2
            total = combined[mid]


        return total
